# Copy this file to .env and fill in real values. docker-compose reads .env
# automatically; for local `flask run` development, load it with:
#   (PowerShell) Get-Content .env | ForEach-Object { if ($_ -match '^(\w+)=(.*)$') { Set-Item "env:$($Matches[1])" $Matches[2] } }

# Generate with: py -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Only needed once you add the cloudflared service in docker-compose.yml.
CLOUDFLARE_TUNNEL_TOKEN=

# Set only if this is served under a sub-path of a domain (e.g. "/showcal"
# for darraghc.ie/showcal) rather than at a domain/subdomain root. See
# README.md "Exposing it at darraghc.ie/showcal via Cloudflare Tunnel".
URL_PREFIX=
