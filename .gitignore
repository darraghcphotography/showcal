__pycache__/
*.pyc
.env
aims.db
# WAL mode leaves two sidecar files beside the database, and the bare
# "aims.db" line above does not match them - they showed up as untracked
# in git status. They hold recent transaction data, so on a dev database
# restored from a production copy they carry real member/login data too.
aims.db-wal
aims.db-shm
data/
uploads/

# Images dropped straight in the project root for manual testing (e.g. a
# sample poster/logo to try an upload with) - not source files. Root-only
# (leading /), so this doesn't touch real image assets under app/static/.
/*.jpg
/*.jpeg
/*.png
/*.gif
/*.webp

# Word's own lock file for any open .docx, wherever it lands.
~$*

# Reference docs dropped in the repo root, not source - e.g. Darragh's
# feedback doc (dcfeedback.docx) or a one-off external audit write-up
# (AUDIT_AND_RECOMMENDATIONS.md, from Gemini Antigravity - see ROADMAP.md).
#
# These are inputs, not repo content: what came out of each one is recorded in
# ROADMAP.md and in the commits that acted on it, which is the part worth
# keeping. Listed by name rather than a *.md wildcard so a genuinely new repo
# document doesn't get silently ignored too.
*.docx
AUDIT_AND_RECOMMENDATIONS.md
DATA_ACCURACY_AND_CORRECTIONS_REPORT.md
DESIGN_AUDIT_AND_PROPOSALS.md
FEATURE_IDEAS.md
GOOGLE_MAPS_INTEGRATION_PROPOSAL.md
SHOW_ENRICHMENT_PROPOSAL.md
venues_report.md

# Source material dropped in the root - AIMS's own branding/mission PDF and
# anything like it. Root-only, so real PDFs under app/ or docs/ are unaffected.
/*.pdf

# Local mockup drafts (HTML/CSS explored outside the app). Mockups normally
# get published as Claude Artifacts for review, not committed here.
/mockups/

# Working-file inbox: spent inputs (logo images already uploaded through the
# app, processed feedback docs, source PDFs) parked out of the repo root
# instead of piling up beside the code. Nothing in here is source.
/inbox/

# Outbound enrichment worklists handed to Antigravity for research (society
# social links, venue categorization, show synopses/rights) - 2026-08-24.
# Raw research output, reviewed and imported through the app's own admin
# tools before anything here reaches the real database; not source.
/enrichment/

# Antigravity proposal docs, 2026-08-24 - same convention as the named docs
# above: inputs, reviewed via ROADMAP.md, not repo content.
VENUE_CATEGORIZATION_PROPOSAL.md
DATA_ENRICHMENT_AND_SCRAPING_OPPORTUNITIES.md

# Throwaway working files - scratch_*.json etc. get created while checking
# something against production and are never repo content.
scratch_*
